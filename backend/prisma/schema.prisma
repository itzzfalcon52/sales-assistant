// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum LeadActionType {
  SEND_WHATSAPP
  SCHEDULE_CALLBACK
  FOLLOW_UP
  CONTINUE_DISCOVERY
}

enum LeadActionStatus {
  PENDING
  COMPLETED
  FAILED
}



model Lead {
  id          String   @id @default(cuid())
  callId      String   @unique
  phoneNumber String?

  business    String?
  products    String?
  budget      String?
  timeline    String?
  features    String[]
  intent      String   @default("UNKNOWN")
  barrier     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  actions      LeadAction[]
  conversation Conversation?
}

model LeadAction {
  id        String           @id @default(cuid())
  leadId    String
  action    LeadActionType
  status    LeadActionStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id])

  @@index([leadId])
}
model Conversation {
  id         String   @id @default(cuid())
  callId     String   @unique
  transcript String?
  startedAt  DateTime?
  endedAt    DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  leadId     String   @unique
  lead       Lead     @relation(fields: [leadId], references: [id])
}